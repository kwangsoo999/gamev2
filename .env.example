# ============================================================================
# ELYSIA NO DENSETSU – Elysia Frontier
# Environment Configuration Template (.env.example)
# Copy to .env for local development. Never commit real secrets or .env files.
# ============================================================================

# Server Network Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Authentication & JWT Security (Replace with a strong random secret in production)
JWT_SECRET=replace_with_secure_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# Frontend / Vite Client Configuration
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
